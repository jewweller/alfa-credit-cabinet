        ],
        "parameters": [
          {
            "name": "inn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(\\d{10}|\\d{12})$",
              "description": "ИНН: 10 цифр (ООО) или 12 (ИП).",

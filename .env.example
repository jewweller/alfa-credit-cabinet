# Скопируйте в .env: cp .env.example .env
# Окружение приложения: local | test | demo | prod
APP_ENV=local
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Docker Compose: PostgreSQL. Значения только для локального демо —
# на общем или облачном стенде задайте свой пароль в .env (он не коммитится).
POSTGRES_DB=alfa_credit
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me-local-demo
# Порт API на этом компьютере (открыт только для 127.0.0.1)
API_PORT=8000

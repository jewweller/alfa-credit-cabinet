# Скопируйте в .env: cp .env.example .env
# Окружение приложения: local | test | demo | prod
APP_ENV=local
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Docker Compose: PostgreSQL. Значения только для локального демо —
# на общем или облачном стенде задайте свой пароль в .env (он не коммитится).
POSTGRES_DB=alfa_credit
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me-local-demo
# Порт API на этом компьютере (открыт только для 127.0.0.1)
API_PORT=8000

# Подпись токенов входа (JWT), не короче 32 символов. Для стенда задайте свою случайную
# строку, например: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-demo-jwt-secret-0123456789
# Загружать демо-учётки и продукты из seed/ (пароль у всех Demo2026!)
SEED_DEMO_DATA=true
# Разрешить администратору сброс демо-данных (удаляет все заявки). На общем стенде — false
DEMO_MODE=true
# Порядок новостей в ленте: true — логистическая регрессия из ml/ (docs/ml-experiment.md),
# при сбое модели автоматически правила; false — всегда правила
ML_RANKING_ENABLED=true

# Фронт (nginx) на этом компьютере: http://localhost:8080
WEB_PORT=8080
# Откуда фронт берёт данные: real — всё в api (все операции контракта реализованы);
# mixed — операции из frontend/src/mocks/real-operations.json в api, остальное — моки в браузере;
# mocks — всё на моках в браузере, без бэка; real — всё в api. После смены: docker compose up --build
VITE_API_MODE=real
# Старый флаг, действует только при пустом VITE_API_MODE: true — mocks, false — real
VITE_USE_MOCKS=true
# Подсказка с демо-учётками на экране входа
VITE_DEMO_MODE=true
